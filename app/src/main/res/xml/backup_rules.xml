<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11-and-lower Auto Backup rules for OrchordsAI.

  Policy: deny-by-default, allow-by-exception. The Android default
  backs up everything in sharedpref/file/database/external except what
  is excluded; we invert that by declaring an explicit allowlist with
  no cross-domain deny rules. Anything outside the listed paths (the
  Room database with conversation content, encryption keys, file-backed
  caches, provider credentials, MCP credentials, and the V6 secondary
  secret store) is not matched by any <include> and therefore stays out
  of Auto Backup.

  The V6 `orchordsai_secondary_secrets` SharedPreferences file contains
  only Android-Keystore-encrypted credential payloads, but it is still
  intentionally excluded. Keystore keys are device-bound and are not
  treated as portable backup material.

  Durable user-data portability is owned by the reviewed first-party
  backup/sync flows (#229/#230), not by Android OS backup.

  Allowlist (portable):
    * sharedpref: orchordsai.preferences (UI-only toggles, theme, layout)

  Everything else is excluded by virtue of not being on the allowlist.
-->
<full-backup-content>
  <!-- Portable: UI preferences -->
  <include domain="sharedpref" path="orchordsai.preferences.xml" />
</full-backup-content>
